{
  "expo": {
    "name": "Bayân",
    "slug": "quran-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "quranapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B3D2E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.weexduunx88.quranapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0B3D2E",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0B3D2E"
          }
        }
      ],
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "enableBackgroundPlayback": true
        }
      ],
      "expo-web-browser",
      "expo-asset",
      "expo-image",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bayân utilise votre position pour calculer les heures de prière exactes de votre lieu.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/notification-sounds/adhan_senegal.mp3",
            "./assets/notification-sounds/adhan_senegal_ios.caf",
            "./assets/notification-sounds/adhan_reunion.mp3",
            "./assets/notification-sounds/adhan_reunion_ios.caf"
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "PrayerTimes",
              "label": "Heures de prière",
              "description": "Les cinq prières du jour et la prochaine, selon votre lieu",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b9448d94-38ae-4418-bf82-2c2033c93664"
      }
    },
    "owner": "weexduunx88"
  }
}
